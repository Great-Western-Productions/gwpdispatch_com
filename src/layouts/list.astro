---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./base.astro";
import ViewListHeader from "@/components/shared/view-list-header.astro";

type Props = {
  header: string;
  kicker?: string;
  description?: string;
  entry: CollectionEntry<"views">;
  category?: string;
};

const { entry, header, kicker, description, category } = Astro.props;
---

<BaseLayout
  entry={entry}
  category={category}
  categoryDescription={category ? description : undefined}
>
  <div class="container pb-16" data-pagefind-ignore="all">
    <ViewListHeader
      title={header}
      kicker={kicker}
      description={description}
    />
    <slot />
  </div>
</BaseLayout>
